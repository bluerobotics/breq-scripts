### T500 STATOR ###


fillhead.pinch_valve_close injector
   
fillhead.pinch_valve_open vacuum

#wait 5 sec

fillhead.set_leak_test_delta 0.5 psi
fillhead.set_leak_test_duration_s 20 sec
fillhead.set_leak_test_target -13
fillhead.set_vacuum_timeout_s 15 sec
fillhead.vacuum_leak_test

wait_for fillhead.temp_c >= 65 60 sec timeout

fillhead.vacuum_on -14
fillhead.pinch_valve_open injector


fillhead.inject 50 ml 4 ml/s 
#30ml, 0.4 is correct
WAIT 5 sec
#fillhead.inject 15 ml 0.2 ml/s


fillhead.pinch_valve_close vacuum
fillhead.pinch_valve_close injector





































